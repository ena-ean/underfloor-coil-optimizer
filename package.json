  "license": "MIT",
  "keywords": [
    "underfloor-heating",
    "bin-packing",
    "optimizer",
    "nextjs",
    "warm-floor"
  ],
  "homepage": "https://coilcalculator.enaserver.ru/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ena-ean/underfloor-coil-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/ena-ean/underfloor-coil-optimizer/issues"
  },
  "author": "ena-ean",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
