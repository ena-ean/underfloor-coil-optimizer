# The application is fully client-side: no database, no secrets.
# Copy this file to `.env.local` only if you need to override defaults.

# Port used by `next start` and by the standalone server in Docker.
PORT=3000

# Canonical origin used by metadata (canonical link, Open Graph).
# Set it to your deployment URL, e.g. https://example.com
# NEXT_PUBLIC_SITE_URL=https://example.com
